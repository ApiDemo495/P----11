{
  "name": "CryptoPrediction4",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Prediction App",
      "onAutoForward": "openBrowser"
    }
  },
  "onCreateCommand": "python3 start.py --detach",
  "postCreateCommand": "python3 start.py --detach",
  "postStartCommand": "python3 start.py --detach",
  "postAttachCommand": "python3 start.py --detach",
  "waitFor": "onCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "shd101wyy.markdown-preview-enhanced",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  }
}
