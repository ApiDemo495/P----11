{
  "name": "CryptoPrediction4",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Prediction App",
      "visibility": "public",
      "onAutoForward": "openPreview",
      "protocol": "https"
    }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "bash scripts/auto_start.sh",
  "postAttachCommand": "bash scripts/auto_start.sh",
  "remoteEnv": {
    "INSTALL_AGENTS": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "shd101wyy.markdown-preview-enhanced",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  }
}
