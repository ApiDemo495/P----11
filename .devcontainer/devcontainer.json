{
  "name": "CryptoPrediction4",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Prediction App",
      "visibility": "private",
      "onAutoForward": "openPreview",
      "protocol": "https"
    }
  },
  "postCreateCommand": "bash scripts/auto_start.sh || true",
  "postStartCommand": "bash scripts/auto_start.sh || true",
  "postAttachCommand": "bash scripts/auto_start.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "shd101wyy.markdown-preview-enhanced",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  },
  "onCreateCommand": "bash scripts/auto_start.sh || true",
  "waitFor": "onCreateCommand",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  }
}